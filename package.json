{
  "name": "portfolio-templates",
  "author": {
    "name": "Madlifi YX",
    "email": "madlifiyx@gmail.com"
  },
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun scripts/build.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last",
    "format": "biome format --write .",
    "prepare": "husky",
    "secrets:check": "gitleaks git --redact .",
    "secrets:staged": "gitleaks git --staged --redact",
    "start": "bun --cwd dist index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check && bun run typecheck && bun run secrets:check && bun run build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "~5.6.2"
  }
}
